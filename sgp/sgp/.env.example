# ============================================
# Variables de entorno para la NUBE (Render + Aiven)
# ============================================
# Referencia: Spring Boot NO lee este archivo.
# En Render estas variables se definen en el dashboard (Environment).
# Nunca subir valores reales de JWT_SECRET, DB_PASSWORD ni de la conexion completa.

# --- Conexion MySQL (Aiven) ---
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:PORT/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=cambiar_por_password_de_aiven

# --- Seguridad JWT (minimo 32 caracteres) ---
# Generarla en PowerShell con:
#   [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
JWT_SECRET=cambiar_por_cadena_aleatoria_de_32_o_mas_caracteres

# --- CORS (dominio del frontend en Vercel) ---
CORS_ALLOWED_ORIGINS=https://tu-app.vercel.app

# --- Admin inicial (opcional) ---
BOOTSTRAP_ADMIN_CORREO=admin@correo.com
BOOTSTRAP_ADMIN_PASSWORD=cambiar_por_password_del_admin

# --- SQL en consola (solo desarrollo) ---
SHOW_SQL=false
