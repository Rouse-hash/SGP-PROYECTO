# ============================================
# Variables de entorno del frontend (Vite)
# ============================================
# Copia este archivo como .env para desarrollo local (NO versionar .env).
# En Vercel esta variable se define en Project Settings -> Environment Variables.

# URL base del backend (Render). En local se deja vacio para usar el proxy de Vite.
VITE_API_URL=http://localhost:8080
